# Server: loopback is the safe default.
AIONEX_HOST=127.0.0.1
AIONEX_PORT=5000
AIONEX_TRUSTED_HOSTS=127.0.0.1,localhost,[::1]
AIONEX_CORS_ORIGINS=
AIONEX_RATE_LIMIT=60
AIONEX_CACHE_TTL=300

# PubMed recommends identifying the application. API key is optional.
PUBMED_EMAIL=
NCBI_API_KEY=

# OpenAlex activity signals are optional and now require an API key.
OPENALEX_API_KEY=

# Content translation is opt-in and requires requirements-translation.txt.
# Text is sent to a Google-backed translation service when enabled.
AIONEX_TRANSLATION_ENABLED=false

# OpenAI chat is opt-in. Messages are sent using the Responses API with store=false.
AIONEX_CHAT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
